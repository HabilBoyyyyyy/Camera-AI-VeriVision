# Copy this file to .env and adjust for your environment.
# main.py reads these via os.environ — load them into the process
# however you prefer (e.g. `python-dotenv`, your process manager, or
# your hosting provider's env var settings).

# Comma-separated list of origins allowed to call the API with
# credentials. Defaults to http://localhost:3000 (the Next.js dev
# server) if unset. Add your deployed frontend's origin here, e.g.:
# ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
