# Copy this file to .env.local and adjust for your environment.
# Next.js only exposes vars prefixed with NEXT_PUBLIC_ to the browser.

# Base URL of the VeriVision backend (FastAPI). Defaults to
# http://localhost:8000 in code if this is unset, so local dev works
# with no setup. Set this to your deployed backend's public URL
# (e.g. https://api.yourdomain.com) when deploying the frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
